rules_version = '2';

// Patrimônio 360 — regras do Firestore
// Cada usuário só acessa os próprios dados. Coleções usadas apenas pelo backend
// (Telegram, códigos de vínculo) ficam fechadas para o navegador: o Firebase Admin
// SDK do backend ignora estas regras, então continua funcionando normalmente.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Assinatura ativa: o backend grava os claims "licensed" e "until" (ms) ao usar uma chave de acesso.
    // O prazo é conferido aqui, a cada leitura/gravação, então vale mesmo se alguém burlar a tela.
    function licensed() {
      return signedIn()
        && request.auth.token.licensed == true
        && request.auth.token.until > request.time.toMillis();
    }

    // Perfil básico criado no cadastro.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nome', 'email', 'createdAt', 'updatedAt', 'photoURL', 'currency', 'language'])
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);

      // Estado financeiro completo do app (users/{uid}/app/state).
      match /app/{docId} {
        allow read, write: if isOwner(uid) && licensed();
      }

      // Memória, perfil e insights da IA: gravados somente pelo backend.
      match /ai/{docId} {
        allow read: if isOwner(uid) && licensed();
        allow write: if false;
      }
    }

    // Integração com Telegram: somente o backend (Admin SDK) lê e grava.
    match /telegramLinkCodes/{code} {
      allow read, write: if false;
    }
    match /telegramLinks/{chatId} {
      allow read, write: if false;
    }
    match /telegramPending/{chatId} {
      allow read, write: if false;
    }
    // Chaves de acesso e assinaturas: somente o backend.
    match /accessKeys/{keyId} {
      allow read, write: if false;
    }
    match /licenses/{uid} {
      allow read, write: if false;
    }

    // Qualquer outra coleção é negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
