PORT=8787
FIREBASE_PROJECT_ID=patrimonio360-e4190

# Firebase Admin
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternativa: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# IA: o P360 Mind roda no navegador, sem chave de API.

# Telegram Bot API
TELEGRAM_BOT_TOKEN=COLOQUE_UM_TOKEN_NOVO_AQUI
TELEGRAM_BOT_USERNAME=Patrimonio360Bot
TELEGRAM_POLL_MS=1500
TELEGRAM_POLLING=false

# Segurança
# No servidor (Render), defina NODE_ENV=production: bloqueia chamadas vindas de localhost.
# NODE_ENV=production
# Origens extras autorizadas a chamar a API (separadas por vírgula).
# As URLs do Firebase Hosting e do Render já estão liberadas no código.
ALLOWED_ORIGINS=
