PORT=8787
FIREBASE_PROJECT_ID=patrimonio360-e4190
P360_MODEL_PATH=./models/expense-net.json

# Firebase Admin (obrigatório para backend/Telegram)
# Opção A: arquivo JSON
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Opção B: JSON em uma única linha (use uma OU outra)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# IA generativa — escolha o provedor em P360_LLM_PROVIDER
# Para o primeiro teste, usamos DeepSeek.
P360_LLM_ENABLED=true
P360_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=COLOQUE_SUA_CHAVE_AQUI
DEEPSEEK_MODEL=deepseek-v4-flash

# Alternativa: Gemini. Para trocar, use P360_LLM_PROVIDER=gemini
# GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI
# GEMINI_MODEL=gemini-3.1-flash-lite

# Telegram Bot API
TELEGRAM_BOT_TOKEN=COLOQUE_UM_TOKEN_NOVO_AQUI
TELEGRAM_BOT_USERNAME=Patrimonio360Bot
TELEGRAM_POLL_MS=1500
