PORT=8787
FIREBASE_PROJECT_ID=patrimonio360-e4190

# Firebase Admin
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternativa: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# IA: o P360 Mind roda no navegador, sem chave de API.

# Telegram Bot API
TELEGRAM_BOT_TOKEN=COLOQUE_UM_TOKEN_NOVO_AQUI
TELEGRAM_BOT_USERNAME=Patrimonio360Bot
TELEGRAM_POLL_MS=1500
# Modo do bot: no Render ele liga sozinho em WEBHOOK (o Telegram avisa o servidor, que pode estar dormindo).
# Local (seu computador): TELEGRAM_POLLING=true. Para desligar de vez: TELEGRAM_MODE=off.
TELEGRAM_POLLING=false
# TELEGRAM_MODE=webhook
# URL pública do backend (o Render já define RENDER_EXTERNAL_URL sozinho):
# TELEGRAM_WEBHOOK_URL=https://patrimonio360-hqka.onrender.com
# Opcional: segredo próprio do webhook (16+ letras/números). Sem isso, é derivado do token.
# TELEGRAM_WEBHOOK_SECRET=

# Segurança
# No servidor (Render), defina NODE_ENV=production: bloqueia chamadas vindas de localhost.
# NODE_ENV=production
# Origens extras autorizadas a chamar a API (separadas por vírgula).
# As URLs do Firebase Hosting e do Render já estão liberadas no código.
ALLOWED_ORIGINS=
